#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5a0c6528e4c0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5a0c6528e650 .scope module, "tb" "tb" 3 2;
 .timescale 0 0;
v0x5a0c652a48e0_0 .var "a", 0 0;
v0x5a0c652a49a0_0 .var "b", 0 0;
v0x5a0c652a4a40_0 .net "y_and", 0 0, L_0x5a0c652a4cd0;  1 drivers
v0x5a0c652a4b10_0 .net "y_or", 0 0, L_0x5a0c652a4e30;  1 drivers
v0x5a0c652a4be0_0 .net "y_xor", 0 0, L_0x5a0c652a4ef0;  1 drivers
S_0x5a0c65254490 .scope module, "dut" "logic_gates" 3 8, 4 2 0, S_0x5a0c6528e650;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y_and";
    .port_info 3 /OUTPUT 1 "y_or";
    .port_info 4 /OUTPUT 1 "y_xor";
L_0x5a0c652a4cd0 .functor AND 1, v0x5a0c652a48e0_0, v0x5a0c652a49a0_0, C4<1>, C4<1>;
L_0x5a0c652a4e30 .functor OR 1, v0x5a0c652a48e0_0, v0x5a0c652a49a0_0, C4<0>, C4<0>;
L_0x5a0c652a4ef0 .functor XOR 1, v0x5a0c652a48e0_0, v0x5a0c652a49a0_0, C4<0>, C4<0>;
v0x5a0c65254620_0 .net "a", 0 0, v0x5a0c652a48e0_0;  1 drivers
v0x5a0c652a4510_0 .net "b", 0 0, v0x5a0c652a49a0_0;  1 drivers
v0x5a0c652a45d0_0 .net "y_and", 0 0, L_0x5a0c652a4cd0;  alias, 1 drivers
v0x5a0c652a4670_0 .net "y_or", 0 0, L_0x5a0c652a4e30;  alias, 1 drivers
v0x5a0c652a4730_0 .net "y_xor", 0 0, L_0x5a0c652a4ef0;  alias, 1 drivers
    .scope S_0x5a0c6528e650;
T_0 ;
    %vpi_call/w 3 18 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 19 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5a0c6528e650 {0 0 0};
    %vpi_call/w 3 21 "$display", "a b | AND OR XOR" {0 0 0};
    %vpi_call/w 3 22 "$display", "----|-----------" {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a0c652a48e0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a0c652a49a0_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 26 "$display", "%0b %0b |  %0b   %0b   %0b", v0x5a0c652a48e0_0, v0x5a0c652a49a0_0, v0x5a0c652a4a40_0, v0x5a0c652a4b10_0, v0x5a0c652a4be0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a0c652a48e0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a0c652a49a0_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 30 "$display", "%0b %0b |  %0b   %0b   %0b", v0x5a0c652a48e0_0, v0x5a0c652a49a0_0, v0x5a0c652a4a40_0, v0x5a0c652a4b10_0, v0x5a0c652a4be0_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a0c652a48e0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a0c652a49a0_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 34 "$display", "%0b %0b |  %0b   %0b   %0b", v0x5a0c652a48e0_0, v0x5a0c652a49a0_0, v0x5a0c652a4a40_0, v0x5a0c652a4b10_0, v0x5a0c652a4be0_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a0c652a48e0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a0c652a49a0_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 38 "$display", "%0b %0b |  %0b   %0b   %0b", v0x5a0c652a48e0_0, v0x5a0c652a49a0_0, v0x5a0c652a4a40_0, v0x5a0c652a4b10_0, v0x5a0c652a4be0_0 {0 0 0};
    %vpi_call/w 3 40 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "testbench.sv";
    "design.sv";
