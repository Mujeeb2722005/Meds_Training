#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5fee4aafc770 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5fee4aafc900 .scope module, "tb" "tb" 3 2;
 .timescale 0 0;
v0x5fee4ab124a0_0 .var "data", 3 0;
v0x5fee4ab12590_0 .var/2s "i", 31 0;
v0x5fee4ab12650_0 .net "parity", 0 0, L_0x5fee4ab12750;  1 drivers
S_0x5fee4aac3490 .scope autotask, "check" "check" 3 16, 3 16 0, S_0x5fee4aafc900;
 .timescale 0 0;
v0x5fee4aac3670_0 .var "actual", 0 0;
v0x5fee4ab11f20_0 .var "expected", 0 0;
v0x5fee4ab11fe0_0 .var/str "name";
TD_tb.check ;
    %load/vec4 v0x5fee4aac3670_0;
    %load/vec4 v0x5fee4ab11f20_0;
    %cmp/ne;
    %jmp/0xz  T_0.0, 6;
    %vpi_call/w 3 18 "$display", "[FAIL] %s: expected=%0b actual=%0b", v0x5fee4ab11fe0_0, v0x5fee4ab11f20_0, v0x5fee4aac3670_0 {0 0 0};
    %jmp T_0.1;
T_0.0 ;
    %vpi_call/w 3 20 "$display", "[PASS] %s: value=%0b", v0x5fee4ab11fe0_0, v0x5fee4aac3670_0 {0 0 0};
T_0.1 ;
    %end;
S_0x5fee4ab12080 .scope module, "dut" "parity_generator" 3 10, 4 2 0, S_0x5fee4aafc900;
 .timescale 0 0;
    .port_info 0 /INPUT 4 "data";
    .port_info 1 /OUTPUT 1 "parity";
v0x5fee4ab12280_0 .net "data", 3 0, v0x5fee4ab124a0_0;  1 drivers
v0x5fee4ab12380_0 .net "parity", 0 0, L_0x5fee4ab12750;  alias, 1 drivers
L_0x5fee4ab12750 .reduce/xor v0x5fee4ab124a0_0;
    .scope S_0x5fee4aafc900;
T_1 ;
    %vpi_call/w 3 24 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 25 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5fee4aafc900 {0 0 0};
    %vpi_call/w 3 27 "$display", "--- Testing 4-bit Parity Generator ---" {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x5fee4ab12590_0, 0, 32;
T_1.0 ;
    %load/vec4 v0x5fee4ab12590_0;
    %cmpi/s 15, 0, 32;
    %flag_or 5, 4;
    %jmp/0xz T_1.1, 5;
    %load/vec4 v0x5fee4ab12590_0;
    %pad/s 4;
    %store/vec4 v0x5fee4ab124a0_0, 0, 4;
    %delay 10, 0;
    %alloc S_0x5fee4aac3490;
    %load/vec4 v0x5fee4ab12650_0;
    %store/vec4 v0x5fee4aac3670_0, 0, 1;
    %vpi_func 3 38 "$countones" 32, v0x5fee4ab124a0_0 {0 0 0};
    %pushi/vec4 2, 0, 32;
    %mod/s;
    %pad/s 1;
    %store/vec4 v0x5fee4ab11f20_0, 0, 1;
    %vpi_func/s 3 38 "$sformatf", "Parity of data=%04b", v0x5fee4ab124a0_0 {0 0 0};
    %store/str v0x5fee4ab11fe0_0;
    %fork TD_tb.check, S_0x5fee4aac3490;
    %join;
    %free S_0x5fee4aac3490;
    %load/vec4 v0x5fee4ab12590_0;
    %addi 1, 0, 32;
    %cast2;
    %store/vec4 v0x5fee4ab12590_0, 0, 32;
    %jmp T_1.0;
T_1.1 ;
    %vpi_call/w 3 41 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "testbench.sv";
    "design.sv";
