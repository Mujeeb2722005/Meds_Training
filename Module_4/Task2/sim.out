#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x58cf7d3754c0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x58cf7d375650 .scope module, "tb" "tb" 3 2;
 .timescale 0 0;
v0x58cf7d38eec0_0 .var "a", 0 0;
v0x58cf7d38ef80_0 .var "ab", 1 0;
v0x58cf7d38f040_0 .var "b", 0 0;
v0x58cf7d38f110_0 .net "y_and", 0 0, L_0x58cf7d38f3a0;  1 drivers
v0x58cf7d38f1e0_0 .net "y_or", 0 0, L_0x58cf7d38f500;  1 drivers
v0x58cf7d38f2d0_0 .net "y_xor", 0 0, L_0x58cf7d38f5c0;  1 drivers
S_0x58cf7d33b490 .scope autotask, "check" "check" 3 19, 3 19 0, S_0x58cf7d375650;
 .timescale 0 0;
v0x58cf7d33b620_0 .var "actual", 0 0;
v0x58cf7d38e6d0_0 .var "expected", 0 0;
v0x58cf7d38e790_0 .var/str "name";
TD_tb.check ;
    %load/vec4 v0x58cf7d33b620_0;
    %load/vec4 v0x58cf7d38e6d0_0;
    %cmp/ne;
    %jmp/0xz  T_0.0, 6;
    %vpi_call/w 3 22 "$display", "[FAIL] %s: expected=%0b actual=%0b at time=%0t", v0x58cf7d38e790_0, v0x58cf7d38e6d0_0, v0x58cf7d33b620_0, $time {0 0 0};
    %jmp T_0.1;
T_0.0 ;
    %vpi_call/w 3 24 "$display", "[PASS] %s: value=%0b at time=%0t", v0x58cf7d38e790_0, v0x58cf7d33b620_0, $time {0 0 0};
T_0.1 ;
    %end;
S_0x58cf7d38e830 .scope module, "dut" "logic_gates" 3 10, 4 2 0, S_0x58cf7d375650;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y_and";
    .port_info 3 /OUTPUT 1 "y_or";
    .port_info 4 /OUTPUT 1 "y_xor";
L_0x58cf7d38f3a0 .functor AND 1, v0x58cf7d38eec0_0, v0x58cf7d38f040_0, C4<1>, C4<1>;
L_0x58cf7d38f500 .functor OR 1, v0x58cf7d38eec0_0, v0x58cf7d38f040_0, C4<0>, C4<0>;
L_0x58cf7d38f5c0 .functor XOR 1, v0x58cf7d38eec0_0, v0x58cf7d38f040_0, C4<0>, C4<0>;
v0x58cf7d38ea30_0 .net "a", 0 0, v0x58cf7d38eec0_0;  1 drivers
v0x58cf7d38eaf0_0 .net "b", 0 0, v0x58cf7d38f040_0;  1 drivers
v0x58cf7d38ebb0_0 .net "y_and", 0 0, L_0x58cf7d38f3a0;  alias, 1 drivers
v0x58cf7d38ec50_0 .net "y_or", 0 0, L_0x58cf7d38f500;  alias, 1 drivers
v0x58cf7d38ed10_0 .net "y_xor", 0 0, L_0x58cf7d38f5c0;  alias, 1 drivers
    .scope S_0x58cf7d375650;
T_1 ;
    %vpi_call/w 3 28 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 29 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x58cf7d375650 {0 0 0};
    %vpi_call/w 3 31 "$display", "Starting Exhaustive Self-Check..." {0 0 0};
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x58cf7d38ef80_0, 0, 2;
T_1.0 ;
    %load/vec4 v0x58cf7d38ef80_0;
    %cmpi/u 3, 0, 2;
    %flag_or 5, 4;
    %jmp/0xz T_1.1, 5;
    %load/vec4 v0x58cf7d38ef80_0;
    %split/vec4 1;
    %store/vec4 v0x58cf7d38f040_0, 0, 1;
    %store/vec4 v0x58cf7d38eec0_0, 0, 1;
    %delay 10, 0;
    %alloc S_0x58cf7d33b490;
    %load/vec4 v0x58cf7d38f110_0;
    %store/vec4 v0x58cf7d33b620_0, 0, 1;
    %load/vec4 v0x58cf7d38eec0_0;
    %load/vec4 v0x58cf7d38f040_0;
    %and;
    %store/vec4 v0x58cf7d38e6d0_0, 0, 1;
    %vpi_func/s 3 40 "$sformatf", "AND (a=%0b, b=%0b)", v0x58cf7d38eec0_0, v0x58cf7d38f040_0 {0 0 0};
    %store/str v0x58cf7d38e790_0;
    %fork TD_tb.check, S_0x58cf7d33b490;
    %join;
    %free S_0x58cf7d33b490;
    %alloc S_0x58cf7d33b490;
    %load/vec4 v0x58cf7d38f1e0_0;
    %store/vec4 v0x58cf7d33b620_0, 0, 1;
    %load/vec4 v0x58cf7d38eec0_0;
    %load/vec4 v0x58cf7d38f040_0;
    %or;
    %store/vec4 v0x58cf7d38e6d0_0, 0, 1;
    %vpi_func/s 3 41 "$sformatf", "OR  (a=%0b, b=%0b)", v0x58cf7d38eec0_0, v0x58cf7d38f040_0 {0 0 0};
    %store/str v0x58cf7d38e790_0;
    %fork TD_tb.check, S_0x58cf7d33b490;
    %join;
    %free S_0x58cf7d33b490;
    %alloc S_0x58cf7d33b490;
    %load/vec4 v0x58cf7d38f2d0_0;
    %store/vec4 v0x58cf7d33b620_0, 0, 1;
    %load/vec4 v0x58cf7d38eec0_0;
    %load/vec4 v0x58cf7d38f040_0;
    %xor;
    %store/vec4 v0x58cf7d38e6d0_0, 0, 1;
    %vpi_func/s 3 42 "$sformatf", "XOR (a=%0b, b=%0b)", v0x58cf7d38eec0_0, v0x58cf7d38f040_0 {0 0 0};
    %store/str v0x58cf7d38e790_0;
    %fork TD_tb.check, S_0x58cf7d33b490;
    %join;
    %free S_0x58cf7d33b490;
    %load/vec4 v0x58cf7d38ef80_0;
    %addi 1, 0, 2;
    %store/vec4 v0x58cf7d38ef80_0, 0, 2;
    %jmp T_1.0;
T_1.1 ;
    %vpi_call/w 3 45 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "testbench.sv";
    "design.sv";
